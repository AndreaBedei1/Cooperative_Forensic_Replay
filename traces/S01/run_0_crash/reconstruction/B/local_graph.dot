digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="THROTTLE_START\nB\nt=0.00", fillcolor="#fde68a"];
  "B:e03" [label="THROTTLE_END\nB\nt=3.95", fillcolor="#fde68a"];
  "B:e04" [label="BRAKE_START\nB\nt=3.95", fillcolor="#fde68a"];
  "B:e05" [label="MOVING_END\nB\nt=5.15", fillcolor="#e5e7eb"];
  "B:e06" [label="STOP_START\nB\nt=5.15", fillcolor="#e5e7eb"];
  "B:e07" [label="COLLISION\nB\nt=6.75", fillcolor="#fca5a5"];
  {rank=same; "B:e01"; "B:e02";}
  {rank=same; "B:e03"; "B:e04";}
  {rank=same; "B:e05"; "B:e06";}
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e01" -> "B:e04" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e02" -> "B:e04" [label="PRECEDES"];
  "B:e03" -> "B:e05" [label="PRECEDES"];
  "B:e03" -> "B:e06" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e04" -> "B:e06" [label="PRECEDES"];
  "B:e05" -> "B:e07" [label="PRECEDES"];
  "B:e06" -> "B:e07" [label="PRECEDES"];
}
