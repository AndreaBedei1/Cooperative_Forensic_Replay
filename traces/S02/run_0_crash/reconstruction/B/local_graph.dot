digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="THROTTLE_START\nB\nt=0.00", fillcolor="#fde68a"];
  "B:e03" [label="THROTTLE_END\nB\nt=3.15", fillcolor="#fde68a"];
  "B:e04" [label="BRAKE_START\nB\nt=3.15", fillcolor="#fde68a"];
  "B:e05" [label="BRAKE_END\nB\nt=3.65", fillcolor="#fde68a"];
  "B:e06" [label="THROTTLE_START\nB\nt=3.75", fillcolor="#fde68a"];
  "B:e07" [label="COLLISION\nB\nt=5.25", fillcolor="#fca5a5"];
  "B:e08" [label="THROTTLE_END\nB\nt=5.25", fillcolor="#fde68a"];
  "B:e09" [label="BRAKE_START\nB\nt=5.25", fillcolor="#fde68a"];
  "B:e10" [label="MOVING_END\nB\nt=5.80", fillcolor="#e5e7eb"];
  "B:e11" [label="STOP_START\nB\nt=5.80", fillcolor="#e5e7eb"];
  {rank=same; "B:e01"; "B:e02";}
  {rank=same; "B:e03"; "B:e04";}
  {rank=same; "B:e07"; "B:e08"; "B:e09";}
  {rank=same; "B:e10"; "B:e11";}
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e01" -> "B:e04" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e02" -> "B:e04" [label="PRECEDES"];
  "B:e03" -> "B:e05" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e05" -> "B:e06" [label="PRECEDES"];
  "B:e06" -> "B:e07" [label="PRECEDES"];
  "B:e06" -> "B:e08" [label="PRECEDES"];
  "B:e06" -> "B:e09" [label="PRECEDES"];
  "B:e07" -> "B:e10" [label="PRECEDES"];
  "B:e07" -> "B:e11" [label="PRECEDES"];
  "B:e08" -> "B:e10" [label="PRECEDES"];
  "B:e08" -> "B:e11" [label="PRECEDES"];
  "B:e09" -> "B:e10" [label="PRECEDES"];
  "B:e09" -> "B:e11" [label="PRECEDES"];
}
