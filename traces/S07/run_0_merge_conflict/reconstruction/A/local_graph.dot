  "A:e05" [label="TURN_RIGHT_END\nA\nt=5.20", fillcolor="#e5e7eb"];
  "A:e06" [label="TURN_LEFT_START\nA\nt=6.35", fillcolor="#e5e7eb"];
  "A:e07" [label="TRACK_APPEARED_LEFT\nA -> track_001\nt=11.65", fillcolor="#bfdbfe"];
  "A:e08" [label="CLOSING_START\nA -> track_001\nt=11.65", fillcolor="#bfdbfe"];
  "A:e09" [label="CRITICAL_TTC_START\nA -> track_001\nt=15.85", fillcolor="#bfdbfe"];
  "A:e10" [label="COLLISION\nA\nt=19.25", fillcolor="#fca5a5"];
  "A:e11" [label="CRITICAL_TTC_END\nA -> track_001\nt=19.25", fillcolor="#bfdbfe"];
  "A:e12" [label="CLOSING_END\nA -> track_001\nt=19.25", fillcolor="#bfdbfe"];
  "A:e13" [label="THROTTLE_END\nA\nt=19.30", fillcolor="#fde68a"];
  "A:e14" [label="BRAKE_START\nA\nt=19.30", fillcolor="#fde68a"];
  "A:e15" [label="TURN_LEFT_END\nA\nt=19.50", fillcolor="#e5e7eb"];
  "A:e16" [label="MOVING_END\nA\nt=20.05", fillcolor="#e5e7eb"];
  "A:e17" [label="STOP_START\nA\nt=20.05", fillcolor="#e5e7eb"];
  {rank=same; "A:e01"; "A:e02";}
  {rank=same; "A:e07"; "A:e08";}
  {rank=same; "A:e10"; "A:e11"; "A:e12";}
  {rank=same; "A:e13"; "A:e14";}
  {rank=same; "A:e16"; "A:e17";}
