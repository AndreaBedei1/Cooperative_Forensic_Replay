digraph "local_C" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle C (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "C:e01" [label="MOVING_START\nC\nt=0.00", fillcolor="#e5e7eb"];
  "C:e02" [label="THROTTLE_START\nC\nt=0.00", fillcolor="#fde68a"];
  "C:e03" [label="TRACK_APPEARED_FRONT\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e04" [label="CLOSING_START\nC -> track_001\nt=0.00", fillcolor="#bfdbfe"];
  "C:e05" [label="TRACK_APPEARED_LEFT\nC -> track_002\nt=0.15", fillcolor="#bfdbfe"];
  "C:e06" [label="CLOSING_START\nC -> track_002\nt=0.15", fillcolor="#bfdbfe"];
  "C:e07" [label="CRITICAL_TTC_START\nC -> track_001\nt=3.65", fillcolor="#bfdbfe"];
  "C:e08" [label="EGO_PATH_ENTRY\nC -> track_001\nt=4.20", fillcolor="#bfdbfe"];
  "C:e09" [label="COLLISION\nC\nt=4.70", fillcolor="#fca5a5"];
  "C:e10" [label="CRITICAL_TTC_END\nC -> track_001\nt=4.70", fillcolor="#bfdbfe"];
  "C:e11" [label="CLOSING_END\nC -> track_001\nt=4.70", fillcolor="#bfdbfe"];
  "C:e12" [label="THROTTLE_END\nC\nt=4.75", fillcolor="#fde68a"];
  "C:e13" [label="BRAKE_START\nC\nt=4.75", fillcolor="#fde68a"];
  "C:e14" [label="CLOSING_END\nC -> track_002\nt=5.05", fillcolor="#bfdbfe"];
  "C:e15" [label="MOVING_END\nC\nt=5.10", fillcolor="#e5e7eb"];
  "C:e16" [label="STOP_START\nC\nt=5.10", fillcolor="#e5e7eb"];
  {rank=same; "C:e01"; "C:e02"; "C:e03"; "C:e04";}
  {rank=same; "C:e05"; "C:e06";}
  {rank=same; "C:e09"; "C:e10"; "C:e11";}
  {rank=same; "C:e12"; "C:e13";}
  {rank=same; "C:e15"; "C:e16";}
  "C:e01" -> "C:e05" [label="PRECEDES"];
  "C:e01" -> "C:e06" [label="PRECEDES"];
  "C:e02" -> "C:e05" [label="PRECEDES"];
  "C:e02" -> "C:e06" [label="PRECEDES"];
  "C:e03" -> "C:e05" [label="PRECEDES"];
  "C:e03" -> "C:e06" [label="PRECEDES"];
  "C:e04" -> "C:e05" [label="PRECEDES"];
  "C:e04" -> "C:e06" [label="PRECEDES"];
  "C:e05" -> "C:e07" [label="PRECEDES"];
  "C:e06" -> "C:e07" [label="PRECEDES"];
  "C:e07" -> "C:e08" [label="PRECEDES"];
  "C:e08" -> "C:e09" [label="PRECEDES"];
  "C:e08" -> "C:e10" [label="PRECEDES"];
  "C:e08" -> "C:e11" [label="PRECEDES"];
  "C:e09" -> "C:e12" [label="PRECEDES"];
  "C:e09" -> "C:e13" [label="PRECEDES"];
  "C:e10" -> "C:e12" [label="PRECEDES"];
  "C:e10" -> "C:e13" [label="PRECEDES"];
  "C:e11" -> "C:e12" [label="PRECEDES"];
  "C:e11" -> "C:e13" [label="PRECEDES"];
  "C:e12" -> "C:e14" [label="PRECEDES"];
  "C:e13" -> "C:e14" [label="PRECEDES"];
  "C:e14" -> "C:e15" [label="PRECEDES"];
  "C:e14" -> "C:e16" [label="PRECEDES"];
  "C:e03" -> "C:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e05" -> "C:e06" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e07" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e10" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e03" -> "C:e11" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "C:e05" -> "C:e14" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}
