digraph "local_B" {
  graph [rankdir=LR, labelloc=t, fontname=Helvetica, label="Local graph - vehicle B (local time)"];
  node [shape=box, style="rounded,filled", fontname=Helvetica, fontsize=10];
  edge [fontname=Helvetica, fontsize=8];
  "B:e01" [label="MOVING_START\nB\nt=0.00", fillcolor="#e5e7eb"];
  "B:e02" [label="THROTTLE_START\nB\nt=0.00", fillcolor="#fde68a"];
  "B:e03" [label="TRACK_APPEARED_FRONT\nB -> track_001\nt=0.35", fillcolor="#bfdbfe"];
  "B:e04" [label="CLOSING_START\nB -> track_001\nt=3.20", fillcolor="#bfdbfe"];
  "B:e05" [label="CRITICAL_TTC_START\nB -> track_001\nt=3.40", fillcolor="#bfdbfe"];
  "B:e06" [label="THROTTLE_END\nB\nt=3.65", fillcolor="#fde68a"];
  "B:e07" [label="BRAKE_START\nB\nt=3.65", fillcolor="#fde68a"];
  "B:e08" [label="CRITICAL_TTC_END\nB -> track_001\nt=4.40", fillcolor="#bfdbfe"];
  "B:e09" [label="CLOSING_END\nB -> track_001\nt=4.85", fillcolor="#bfdbfe"];
  "B:e10" [label="MOVING_END\nB\nt=4.85", fillcolor="#e5e7eb"];
  "B:e11" [label="STOP_START\nB\nt=4.85", fillcolor="#e5e7eb"];
  "B:e12" [label="COLLISION\nB\nt=5.90", fillcolor="#fca5a5"];
  {rank=same; "B:e01"; "B:e02";}
  {rank=same; "B:e06"; "B:e07";}
  {rank=same; "B:e09"; "B:e10"; "B:e11";}
  "B:e01" -> "B:e03" [label="PRECEDES"];
  "B:e02" -> "B:e03" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="PRECEDES"];
  "B:e04" -> "B:e05" [label="PRECEDES"];
  "B:e05" -> "B:e06" [label="PRECEDES"];
  "B:e05" -> "B:e07" [label="PRECEDES"];
  "B:e06" -> "B:e08" [label="PRECEDES"];
  "B:e07" -> "B:e08" [label="PRECEDES"];
  "B:e08" -> "B:e09" [label="PRECEDES"];
  "B:e08" -> "B:e10" [label="PRECEDES"];
  "B:e08" -> "B:e11" [label="PRECEDES"];
  "B:e09" -> "B:e12" [label="PRECEDES"];
  "B:e10" -> "B:e12" [label="PRECEDES"];
  "B:e11" -> "B:e12" [label="PRECEDES"];
  "B:e03" -> "B:e04" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e03" -> "B:e05" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e03" -> "B:e08" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
  "B:e03" -> "B:e09" [label="SAME_TRACK", style=dashed, color="#2563eb", constraint=false];
}
